{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "web-worker",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-29",
  "workers_dev": false,
  "routes": [
    {
      "pattern": "solarianetwork.site/*",
      "zone_name": "solarianetwork.site"
    }
  ],
  "vars": {
    "ORIGIN_HOST": "origin.solarianetwork.site",
    "HONEYPOT_BAN_TTL_SECONDS": "3600"
  },
  "triggers": {
    "crons": ["*/15 * * * *"]
  },
  "previews": {
    "vars": {
      "ORIGIN_HOST": "",
      "HONEYPOT_BAN_TTL_SECONDS": "3600"
    }
  },
  "observability": {
    "enabled": true
  }
}
